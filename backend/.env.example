PORT=5000
POSTGRES_URI=postgresql://user:password@host:5432/nyx
JWT_SECRET=replace-with-a-secure-random-string
PUBLIC_API_URL=https://your-api.example.com
COLI_AUTH_REDIRECT_URL=coli://auth
OAUTH_WEB_ORIGIN=https://your-app.example.com
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
ollama_API_KEY=your_ollama_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
NEWS_API_KEY=your_news_api_key_here

# Environment (development, production)
NODE_ENV=development

# Quick Start
# 1. Copy this file to .env
#    cp .env.example .env
# 2. Update POSTGRES_URI with a live PostgreSQL database
# 3. Add your ollama and ElevenLabs API keys
# 4. Run:
#    npm install
#    npm run dev
# 5. Verify:
#    http://localhost:5000/health
